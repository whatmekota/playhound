# The Handy: credentials from the developer portal. Only the application ID
# is built into the app (VITE_HANDY_APP_ID in .env.local); the key and the
# access token never leave this machine.
/appid
/appkey
/handytoken

# Android app (android/): Gradle and Kotlin output, the web build that cap
# sync copies in, generated config, the local SDK path. Listed here as well as
# in android/.gitignore so the root tools (ESLint) skip them too.
android/.gradle/
android/.kotlin/
android/.idea/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
android/capacitor-cordova-android-plugins/
android/local.properties
*.apk
*.aab
# Signing keys never go in the repo (debug builds sign with the toolchain's own key).
*.keystore
*.jks

# Android release signing: the key and its passwords live outside the repo
# (<toolchain>/keys by default; see android/app/build.gradle).
keystore.properties
