<?xml version="1.0" encoding="utf-8"?>
<!-- Capacitor's own layout, with the app's WebView in place of
     CapacitorWebView: session/PhWebView.kt keeps the page running behind
     the session service's notification. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity">

    <io.github.whatmekota.playhound.session.PhWebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
