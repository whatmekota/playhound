{
  "name": "playhound",
  "type": "module",
  "version": "2.2.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "Audiovisual session engine and funscript video player with TCode/OSR device support",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host --port 6969",
    "dev:proxy": "node es-proxy.mjs",
    "app": "node desktop/dev.mjs",
    "app:build": "vite build && node desktop/build.mjs",
    "app:dir": "vite build && node desktop/build.mjs --dir",
    "mobile:dev": "vite --host --port 7140 --strictPort",
    "mobile:sync": "node android/run.mjs sync",
    "mobile:apk": "node android/run.mjs apk",
    "mobile:install": "node android/run.mjs install",
    "mobile:test": "node android/run.mjs test",
    "mobile:icons": "node android/icons.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "vue-tsc",
    "preview": "vite preview",
    "test": "vitest",
    "up": "taze major -I",
    "postinstall": "npx simple-git-hooks"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "catalog:mobile",
    "@capacitor/core": "catalog:mobile",
    "@vueuse/core": "catalog:frontend",
    "buttplug": "catalog:frontend",
    "hls.js": "catalog:frontend",
    "mp4box": "catalog:frontend",
    "osr-emu": "catalog:frontend",
    "pinia": "catalog:frontend",
    "three": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-router": "catalog:frontend"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@capacitor/android": "catalog:mobile",
    "@capacitor/cli": "catalog:mobile",
    "@iconify-json/carbon": "catalog:build",
    "@resvg/resvg-js": "catalog:desktop",
    "@types/node": "catalog:dev",
    "@types/three": "catalog:dev",
    "@types/w3c-web-serial": "catalog:dev",
    "@unocss/eslint-plugin": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/test-utils": "catalog:dev",
    "@xhayper/discord-rpc": "catalog:desktop",
    "electron": "catalog:desktop",
    "electron-builder": "catalog:desktop",
    "electron-updater": "catalog:desktop",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "jsdom": "catalog:build",
    "lint-staged": "catalog:dev",
    "megajs": "catalog:",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev",
    "undici": "catalog:",
    "unocss": "catalog:build",
    "unplugin-auto-import": "catalog:build",
    "unplugin-vue-components": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:dev",
    "ws": "catalog:"
  },
  "resolutions": {
    "unplugin": "catalog:build",
    "vite": "catalog:build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "pnpm exec eslint --fix"
  }
}
